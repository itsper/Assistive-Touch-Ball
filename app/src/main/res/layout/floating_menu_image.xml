<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_image_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header -->
        <RelativeLayout
            android:id="@+id/layout_image_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp">

            <ImageButton
                android:id="@+id/btn_image_back"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_back"
                android:tint="#FFFFFF"
                android:background="@drawable/btn_item_bg"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:padding="4dp"
                android:contentDescription="Back" />

            <TextView
                android:id="@+id/txt_image_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Albums"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@id/btn_image_back"
                android:layout_toStartOf="@+id/layout_header_actions"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="4dp" />

            <LinearLayout
                android:id="@+id/layout_header_actions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true">

                <!-- Sort Button -->
                <ImageButton
                    android:id="@+id/btn_image_sort"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_sort"
                    android:tint="#FFFFFF"
                    android:background="@drawable/btn_item_bg"
                    android:padding="4dp"
                    android:layout_marginEnd="4dp"
                    android:contentDescription="Sort" />

                <!-- Size Toggle (Compact / Expanded) -->
                <ImageButton
                    android:id="@+id/btn_image_size"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_fullscreen"
                    android:tint="#FFFFFF"
                    android:background="@drawable/btn_item_bg"
                    android:padding="4dp"
                    android:layout_marginEnd="4dp"
                    android:contentDescription="Resize" />

                <!-- Close Button -->
                <ImageButton
                    android:id="@+id/btn_image_close"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_close"
                    android:tint="#FFFFFF"
                    android:background="@drawable/btn_item_bg"
                    android:padding="4dp"
                    android:contentDescription="Close" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Content Area -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- STATE 1: Folders / Albums List -->
            <FrameLayout
                android:id="@+id/layout_albums_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="visible">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_image_albums"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scrollbars="vertical" />

                <LinearLayout
                    android:id="@+id/txt_empty_images"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="No photos found on device"
                        android:textColor="#88FFFFFF"
                        android:textSize="10sp"
                        android:gravity="center" />

                    <TextView
                        android:id="@+id/btn_scan_images"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Scan Photos"
                        android:textColor="#FFFFFF"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:background="@drawable/btn_item_bg"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp"
                        android:layout_marginTop="8dp"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>
            </FrameLayout>

            <!-- STATE 2: Folder Photo Grid -->
            <FrameLayout
                android:id="@+id/layout_grid_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_image_grid"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scrollbars="vertical" />
            </FrameLayout>

            <!-- STATE 3: Swipeable Photo Viewer with Pinch Zoom -->
            <FrameLayout
                android:id="@+id/layout_viewer_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/viewpager_images"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <!-- Bottom Photo Index Badge -->
                <TextView
                    android:id="@+id/txt_viewer_counter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_tab_badge"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:text="1 / 1"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif-medium" />
            </FrameLayout>

        </FrameLayout>
    </LinearLayout>

</FrameLayout>
