<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="6dp">

    <!-- Top Header Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:layout_marginBottom="4dp">

        <!-- Back to floating tools menu -->
        <ImageButton
            android:id="@+id/btn_browser_back_to_menu"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_back"
            android:tint="#FFFFFF"
            android:background="@drawable/btn_item_bg"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:padding="5dp"
            android:contentDescription="Back to menu" />

        <!-- Title / Status text -->
        <TextView
            android:id="@+id/txt_browser_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Web Browser"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@id/btn_browser_back_to_menu"
            android:layout_toStartOf="@+id/layout_header_actions"
            android:layout_marginHorizontal="6dp" />

        <LinearLayout
            android:id="@+id/layout_header_actions"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Window Size Toggle (Compact / Expand) -->
            <ImageButton
                android:id="@+id/btn_browser_size_toggle"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_fullscreen"
                android:tint="#88FFFFFF"
                android:background="@drawable/btn_item_bg"
                android:padding="5dp"
                android:layout_marginEnd="4dp"
                android:contentDescription="Toggle size" />

            <!-- Close Entire Floating Overlay -->
            <ImageButton
                android:id="@+id/btn_browser_close"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_close"
                android:tint="#FFEF5350"
                android:background="@drawable/btn_item_bg"
                android:padding="5dp"
                android:contentDescription="Close floating menu" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Search / URL Omnibox -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/btn_item_bg"
        android:paddingHorizontal="6dp"
        android:layout_marginBottom="2dp">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_search"
            android:tint="#99FFFFFF"
            android:layout_marginEnd="4dp"
            android:contentDescription="Search" />

        <EditText
            android:id="@+id/edt_browser_url"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:hint="Search Google or enter URL..."
            android:textColor="#FFFFFF"
            android:textColorHint="#66FFFFFF"
            android:textSize="10.5sp"
            android:singleLine="true"
            android:maxLines="1"
            android:imeOptions="actionGo"
            android:inputType="textUri"
            android:background="@null"
            android:padding="0dp" />

        <ImageButton
            android:id="@+id/btn_browser_clear_url"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_close"
            android:tint="#77FFFFFF"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="2dp"
            android:visibility="gone"
            android:contentDescription="Clear" />

        <TextView
            android:id="@+id/btn_browser_go"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="Go"
            android:textColor="#4FC3F7"
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingStart="6dp"
            android:paddingEnd="2dp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Page Load Progress Bar -->
    <ProgressBar
        android:id="@+id/progress_browser"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2.5dp"
        android:max="100"
        android:progress="0"
        android:progressTint="#4FC3F7"
        android:visibility="gone" />

    <!-- Embedded WebView Container with rounded framing -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#15000000"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="4dp">

        <WebView
            android:id="@+id/webview_browser"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="vertical" />

        <!-- Error / Retry layout -->
        <LinearLayout
            android:id="@+id/layout_browser_error"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:background="#DD121212"
            android:padding="12dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/presence_offline"
                android:tint="#77FFFFFF" />

            <TextView
                android:id="@+id/txt_browser_error_msg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Unable to load page"
                android:textColor="#AAFFFFFF"
                android:textSize="10sp"
                android:layout_marginTop="4dp"
                android:gravity="center" />

            <TextView
                android:id="@+id/btn_browser_retry"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:text="Retry"
                android:textColor="#4FC3F7"
                android:textSize="10sp"
                android:textStyle="bold"
                android:background="@drawable/btn_item_bg"
                android:paddingHorizontal="10dp"
                android:gravity="center"
                android:layout_marginTop="6dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </FrameLayout>

    <!-- Bottom Navigation Controls Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="26dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="2dp">

        <!-- History Back -->
        <ImageButton
            android:id="@+id/btn_web_back"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/ic_back"
            android:tint="#88FFFFFF"
            android:background="@drawable/btn_item_bg"
            android:padding="5dp"
            android:layout_marginEnd="2dp"
            android:contentDescription="Previous page" />

        <!-- History Forward -->
        <ImageButton
            android:id="@+id/btn_web_forward"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/ic_arrow_forward"
            android:tint="#88FFFFFF"
            android:background="@drawable/btn_item_bg"
            android:padding="5dp"
            android:layout_marginHorizontal="2dp"
            android:contentDescription="Next page" />

        <!-- Refresh / Reload -->
        <ImageButton
            android:id="@+id/btn_web_refresh"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/ic_refresh"
            android:tint="#FFFFFF"
            android:background="@drawable/btn_item_bg"
            android:padding="5dp"
            android:layout_marginHorizontal="2dp"
            android:contentDescription="Refresh page" />

        <!-- Home (Google Search) -->
        <ImageButton
            android:id="@+id/btn_web_home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/ic_home"
            android:tint="#FFFFFF"
            android:background="@drawable/btn_item_bg"
            android:padding="5dp"
            android:layout_marginHorizontal="2dp"
            android:contentDescription="Home page" />

        <!-- Open in external browser app -->
        <ImageButton
            android:id="@+id/btn_web_open_external"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/ic_open_in_browser"
            android:tint="#FFFFFF"
            android:background="@drawable/btn_item_bg"
            android:padding="5dp"
            android:layout_marginStart="2dp"
            android:contentDescription="Open in external browser" />
    </LinearLayout>

</LinearLayout>
